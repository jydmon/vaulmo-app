{
  "name": "lifehub-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vaulmo Platform — Phase 1 foundation (API, web shell, mobile shell, infra)",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm --workspace @lifehub/api run dev",
    "dev:web": "npm --workspace @lifehub/web run dev",
    "migrate": "npm --workspace @lifehub/api run db:migrate",
    "seed": "npm --workspace @lifehub/api run seed",
    "test": "npm --workspace @lifehub/api run test:e2e",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
