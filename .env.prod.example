# Vaulmo production settings. Copy this file to ".env" on your server and fill in
# real values:   cp .env.prod.example .env   then edit .env
# NEVER commit the real .env — it holds secrets. (.gitignore already excludes it.)

# Domains that point at this server (create A records -> your VPS IP first):
#   LANDING_DOMAIN -> the marketing/landing page   (vaulmo.com)
#   APP_DOMAIN     -> the web application           (app.vaulmo.com)
LANDING_DOMAIN=vaulmo.com
APP_DOMAIN=app.vaulmo.com

# Database
POSTGRES_USER=vaulmo
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=vaulmo

# Auth secrets — use long random strings (e.g. `openssl rand -base64 32` for each)
JWT_ACCESS_SECRET=change-me-random-1
JWT_REFRESH_SECRET=change-me-random-2

# Encryption key for 2FA secrets & connected-account tokens.
# Generate with:  openssl rand -base64 32
# SET ONCE and never change it, or encrypted data becomes unreadable. Keep a backup.
ENCRYPTION_KEY=change-me-32-byte-base64-key

# First admin account (created by the one-time seed)
SUPERADMIN_EMAIL=you@yourdomain.com
SUPERADMIN_PASSWORD=change-me-strong-password

# ---- Connected Services (email import) — OPTIONAL ----
# Leave blank to keep Connected Services in sandbox mode (internal testers only).
# Fill these in to switch on REAL Gmail / Outlook import for all subscribed users.
# The redirect URI must exactly match the one registered in each provider console.
INTEGRATIONS_REDIRECT_URI=https://app.vaulmo.com/integrations/callback
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra (Azure AD) → App registrations → your app → client secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Social sign-in (ACC-02) ─────────────────────────────────────────────
# The Google/Microsoft client IDs above are reused for "Sign in with Google/Microsoft".
# Each provider's redirect/callback URL is:  https://app.vaulmo.com/api/v1/auth/oauth/<provider>/callback
# APP_BASE_URL is the public web-app URL used to build OAuth redirects and to bounce users back.
APP_BASE_URL=https://app.vaulmo.com
# Sign in with Apple (optional). From the Apple Developer portal (Service ID + a Sign in
# with Apple key). Paste the .p8 contents as one line with literal \n between lines.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Live email delivery (REM-09) ────────────────────────────────────────
# Set SMTP_HOST to send real email; leave blank to log to the dev outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Vaulmo <no-reply@vaulmo.com>

# ── Live push delivery (REM-08) ─────────────────────────────────────────
# Push uses Expo Push (relays to FCM/APNs). No server key needed for basic use; an
# optional Expo access token raises rate limits. FCM/APNs are configured in the Expo
# project, not here.
EXPO_ACCESS_TOKEN=
