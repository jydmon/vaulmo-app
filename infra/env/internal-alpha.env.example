# Internal Alpha environment TEMPLATE. Copy to infra/env/internal-alpha.env and fill
# from your secret store. This environment is for INTERNAL TESTERS ONLY.
#
# Access control: Phase 2/3 vault features are gated by the is_internal_tester flag
# on each user (enforced by the API). Only flagged accounts can reach the vault.
#
# Testing policy: use SYNTHETIC test documents only — do NOT upload real highly
# sensitive documents at this stage.

APP_ENV=staging            # runs with production-like settings; not public
POSTGRES_USER=lifehub_alpha
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=lifehub_alpha
DATABASE_URL=postgresql://lifehub_alpha:__set_me__@db.internal:5432/lifehub_alpha?sslmode=require

JWT_ACCESS_SECRET=__set_me__
JWT_REFRESH_SECRET=__set_me__
MFA_ISSUER=LifeHub

STORAGE_DRIVER=s3
S3_BUCKET=lifehub-alpha-files
S3_REGION=eu-west-2

CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info

# Seed a set of internal testers after deploy (mark accounts is_internal_tester=true).
REGISTRY=ghcr.io/your-org
TAG=internal-alpha
