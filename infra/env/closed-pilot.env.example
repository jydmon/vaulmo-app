# Closed Pilot environment TEMPLATE. A small group of REAL pilot users, invited by flag
# (is_internal_tester). Phases 4 & 5 (reminders + AI assistant) are live here.
# Billing (Phase 6) runs Stripe in TEST mode during the pilot — no real charges.

APP_ENV=staging
DATABASE_URL=postgresql://lifehub_pilot:__set_me__@db.internal:5432/lifehub_pilot?sslmode=require
JWT_ACCESS_SECRET=__set_me__
JWT_REFRESH_SECRET=__set_me__
MFA_ISSUER=LifeHub
STORAGE_DRIVER=s3
S3_BUCKET=lifehub-pilot-files
S3_REGION=eu-west-2
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info

# Notifications: wire real providers here (SES/SMTP for email, FCM/APNs for push).
EMAIL_DRIVER=ses
PUSH_DRIVER=fcm

# The reminder engine must be scheduled (cron/worker) to POST /notifications/run-tick.
REMINDER_TICK_CRON="0 * * * *"

# Stripe in TEST mode for the pilot.
STRIPE_DRIVER=stripe
STRIPE_SECRET_KEY=sk_test___set_me__
STRIPE_WEBHOOK_SECRET=whsec___set_me__

REGISTRY=ghcr.io/your-org
TAG=closed-pilot

EMERGENCY_ACCESS_ENABLED=false
ENCRYPTION_KEY=__set_me__
