# Staging environment TEMPLATE. Copy to infra/env/staging.env and fill from your
# secret store. NEVER commit the real staging.env (it is gitignored).
#
# Real secrets should come from a managed secret store (AWS Secrets Manager,
# GCP Secret Manager, Doppler, Vault, ...) and be injected at deploy time.

APP_ENV=staging
POSTGRES_USER=lifehub_staging
POSTGRES_PASSWORD=__set_me__
POSTGRES_DB=lifehub_staging

# Point at the managed Postgres instance (TLS required).
DATABASE_URL=postgresql://lifehub_staging:__set_me__@db.internal:5432/lifehub_staging?sslmode=require

# Generate strong unique secrets per environment: `openssl rand -base64 48`
JWT_ACCESS_SECRET=__set_me__
JWT_REFRESH_SECRET=__set_me__
MFA_ISSUER=LifeHub

# Object storage for files (S3 / R2 / MinIO)
STORAGE_DRIVER=s3
S3_BUCKET=lifehub-staging-files
S3_REGION=eu-west-2
S3_ENDPOINT=

# Only internal origins in staging — no public web origin yet.
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info

# Stripe (Phase 6). Staging uses TEST-mode keys; NEVER live keys in staging.
STRIPE_DRIVER=stripe            # 'fake' for CI/dev, 'stripe' for staging/live
STRIPE_SECRET_KEY=sk_test___set_me__
STRIPE_WEBHOOK_SECRET=whsec___set_me__

# Registry + tag CI sets on promotion
REGISTRY=ghcr.io/your-org
TAG=staging

# Phase 8 emergency access flag (keep false until legal/identity/process ready)
EMERGENCY_ACCESS_ENABLED=false

# Phase 9 token encryption key — 32 bytes (base64 or hex). Generate: openssl rand -base64 32
ENCRYPTION_KEY=__set_me__
